# URL base de la API (backend).
# IMPORTANTE: apunta SIEMPRE a https en producción.
# En local (VITE_ENV=development) puedes usar http://localhost:8080.
# El build de producción NO incluye datos de ejemplo:
# si VITE_API_URL está vacío, la app se queda en la pantalla de carga.
VITE_API_URL=http://localhost:8080

# WebSocket para notificaciones en vivo (mismo host que VITE_API_URL).
VITE_WS_URL=ws://localhost:8080

# development | production
VITE_ENV=development
