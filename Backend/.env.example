# Entorno: development | test | production
NODE_ENV=development

PORT=8080

# URL pública del frontend (origen permitido en CORS y base de las URLs de Stripe)
CLIENT_URL=http://localhost:5173

# Orígenes CORS adicionales, separados por coma (además de CLIENT_URL y localhost en dev)
# CORS_ORIGINS=https://app.news-today.example,https://admin.news-today.example

# Supabase: obligatorio en producción (SUPABASE_URL + SUPABASE_SECRET_KEY)
# SUPABASE_PUBLISHABLE_KEY (sb_publishable_*): clave pública del cliente
# SUPABASE_SECRET_KEY (sb_secret_*): clave de servidor (BYPASSRLS), nunca en el frontend
# SUPABASE_JWKS_URL: si se omite, se deduce de SUPABASE_URL (/auth/v1/.well-known/jwks.json)
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxx
SUPABASE_SECRET_KEY=sb_secret_xxxx
# SUPABASE_JWKS_URL=https://tu-proyecto.supabase.co/auth/v1/.well-known/jwks.json

# Usuario admin creado por el seed (el primer usuario registrado en la app es editor)
ADMIN_USER=admin
ADMIN_EMAIL=cambia@ejemplo.com
ADMIN_PASS=cambia_esta_password

# HTTPS: si se indican rutas de certificado y clave, la API sirve por https
# SSL_CERT_PATH=/etc/ssl/news-today/fullchain.pem
# SSL_KEY_PATH=/etc/ssl/news-today/privkey.pem

# Detrás de un proxy reverso (nginx/Cloudflare): 'true', número de saltos o CIDR
# TRUST_PROXY=true

# Stripe (Fase 2 — autoservicio "Pon aquí tu publicidad": el comercio paga y se activa solo).
# Sin clave, los anuncios se gestionan manualmente desde el panel de Administración.
# STRIPE_SECRET_KEY=sk_test_xxxx
# STRIPE_IMAGE_PRICE_ID=price_xxxx
# STRIPE_VIDEO_PRICE_ID=price_xxxx
# STRIPE_WEBHOOK_SECRET=whsec_xxxx
