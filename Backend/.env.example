# Entorno: development | test | production
NODE_ENV=development

PORT=8080

# URL pública del frontend (origen permitido en CORS y base de las URLs de Stripe)
CLIENT_URL=http://localhost:5173

# Orígenes CORS adicionales, separados por coma (además de CLIENT_URL y localhost en dev)
# CORS_ORIGINS=https://app.news-today.example,https://admin.news-today.example

# MongoDB: si no se configura, se usa un MongoDB real en memoria (datos efímeros)
# MONGO_URI=mongodb+srv://usuario:password@cluster.mongodb.net/news-today

# Autenticación: JWT_SECRET es obligatorio en producción
JWT_SECRET=cambia_este_secreto
JWT_EXPIRES=7d

# Usuario admin creado por el seed (el primer usuario registrado en la app es editor)
ADMIN_USER=admin
ADMIN_EMAIL=cambia@ejemplo.com
ADMIN_PASS=cambia_esta_password

# HTTPS: si se indican rutas de certificado y clave, la API sirve por https
# SSL_CERT_PATH=/etc/ssl/news-today/fullchain.pem
# SSL_KEY_PATH=/etc/ssl/news-today/privkey.pem

# Detrás de un proxy reverso (nginx/Cloudflare): 'true', número de saltos o CIDR
# TRUST_PROXY=true

# Stripe (opcional: sin clave el checkout de pago queda inactivo)
# STRIPE_SECRET_KEY=sk_test_xxxx
# STRIPE_PRICE_ID=price_xxxx
# STRIPE_WEBHOOK_SECRET=whsec_xxxx
# STRIPE_SUCCESS_URL=https://app.news-today.example/suscripcion?estado=exito
# STRIPE_CANCEL_URL=https://app.news-today.example/suscripcion?estado=cancelado

# Email (opcional: sin SMTP_HOST se muestra por consola en modo dev)
# SMTP_HOST=smtp.ejemplo.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=usuario
# SMTP_PASS=password
# SMTP_FROM=News Today <no-reply@news-today.example>
